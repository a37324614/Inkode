{
  "makefile.configureOnOpen": true,
  "security.workspace.trust.untrustedFiles": "open",
  "workbench.startupEditor": "none",
  "files.autoSave": "afterDelay",
  "files.autoGuessEncoding": true,
  "workbench.list.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.cursorBlinking": "smooth",
  "editor.mouseWheelZoom": true,
  "editor.formatOnPaste": true,
  "editor.formatOnType": true,
  "editor.formatOnSave": true,
  "editor.wordWrap": "on",
  "editor.guides.bracketPairs": true,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.acceptSuggestionOnEnter": "smart",
  "editor.suggestSelection": "recentlyUsed",
  "window.dialogStyle": "custom",
  "debug.showBreakpointsInOverviewRuler": true,
  "workbench.colorTheme": "One Dark Pro Darker",
  "workbench.iconTheme": "vscode-jetbrains-icon-theme-2023-auto",
  "editor.fontFamily": "JetBrains Mono",
  "editor.fontLigatures": true,
  "editor.fontSize": 16,
  "editor.unicodeHighlight.nonBasicASCII": false,
  "markdown-preview-enhanced.revealjsTheme": "black.css",
  "markdown-preview-enhanced.previewTheme": "atom-dark.css",
  "markdown-preview-enhanced.codeBlockTheme": "vscode.css",
  "EIDE.ARM.GCC.Prefix": "arm-none-eabi-",
  "EIDE.DisplayLanguage": "zh-cn",
  "git.openRepositoryInParentFolders": "always",
  "git.enableSmartCommit": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "scm.repositories.selectionMode": "single",
  "extensions.autoUpdate": "off",
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "// --- 去 AI 与极简静音设定 ---": "",
  "editor.inlineSuggest.enabled": false,
  "chat.commandCenter.enabled": false,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "workbench.experimental.chat.enabled": false,
  "telemetry.telemetryLevel": "off",
  "update.mode": "none"
}